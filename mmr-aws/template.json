{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "USTC Dota shared player registration",
  "Parameters": {
    "WritesEnabled": {
      "Type": "String",
      "AllowedValues": ["false", "true"],
      "Default": "false"
    }
  },
  "Resources": {
    "Registration": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AttributeDefinitions": [{ "AttributeName": "id", "AttributeType": "S" }],
        "KeySchema": [{ "AttributeName": "id", "KeyType": "HASH" }],
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true }
      }
    },
    "FunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/aws/lambda/${AWS::StackName}-api" },
        "RetentionInDays": 14
      }
    },
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": { "Service": "lambda.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }]
        },
        "Policies": [{
          "PolicyName": "RegistrationState",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
              "Resource": { "Fn::GetAtt": ["Registration", "Arn"] },
              "Condition": {
                "ForAllValues:StringEquals": { "dynamodb:LeadingKeys": ["state"] }
              }
            }, {
              "Effect": "Allow",
              "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
              "Resource": { "Fn::GetAtt": ["FunctionLogs", "Arn"] }
            }]
          }
        }]
      }
    },
    "RegistrationFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${AWS::StackName}-api" },
        "Runtime": "nodejs22.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 10,
        "Role": { "Fn::GetAtt": ["FunctionRole", "Arn"] },
        "Environment": {
          "Variables": {
            "TABLE_NAME": { "Ref": "Registration" },
            "MMR_WRITES_ENABLED": { "Ref": "WritesEnabled" }
          }
        },
        "Code": { "ZipFile": "" }
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": { "Ref": "AWS::StackName" },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": ["https://bcszsz.github.io"],
          "AllowMethods": ["GET", "PUT", "OPTIONS"],
          "AllowHeaders": ["content-type"],
          "MaxAge": 300
        }
      }
    },
    "GatewayIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": { "Ref": "HttpApi" },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": { "Fn::GetAtt": ["RegistrationFunction", "Arn"] },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 12000
      }
    },
    "GatewayRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "HttpApi" },
        "RouteKey": "$default",
        "Target": { "Fn::Sub": "integrations/${GatewayIntegration}" }
      }
    },
    "GatewayPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": { "Ref": "RegistrationFunction" },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*" }
      }
    },
    "GatewayStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "DependsOn": ["GatewayRoute", "GatewayPermission"],
      "Properties": {
        "ApiId": { "Ref": "HttpApi" },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        }
      }
    }
  },
  "Outputs": {
    "Endpoint": { "Value": { "Fn::Sub": ["${Origin}/api/mmr", { "Origin": { "Fn::GetAtt": ["HttpApi", "ApiEndpoint"] } }] } },
    "TableName": { "Value": { "Ref": "Registration" } }
  }
}
